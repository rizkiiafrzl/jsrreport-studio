{"type":"error","timestamp":1757857966590,"entity":{"shortid":"BlY8W4JpJ","name":"pdf","content":"<!DOCTYPE html>\r\n<html lang=\"id\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <title>{{reportInfo.title}}</title>\r\n  <style>\r\n    /* ====== A4 landscape & tata letak ====== */\r\n    @page { size: A4 landscape; margin: 8mm; }\r\n    html, body { margin: 0; font-family: Arial, Helvetica, sans-serif; }\r\n\r\n    /* ====== Header: logo kiri, judul tengah, meta kanan (GRID) ====== */\r\n    .page-header{\r\n      display: grid;\r\n      grid-template-columns: auto 1fr auto; /* kiri | tengah fleksibel | kanan */\r\n      align-items: center;\r\n      margin-bottom: 8px;\r\n      gap: 12px;\r\n    }\r\n\r\n    /* kiri (logo) */\r\n    .brand{\r\n      display: flex;\r\n      align-items: center;\r\n      gap: 0;\r\n    }\r\n    .brand-logo{\r\n      height: 100px;       /* besarkan sesuai kebutuhan (80–110px) */\r\n      width: auto;\r\n      object-fit: contain;\r\n      display: block;\r\n    }\r\n\r\n    /* tengah (judul) */\r\n    .brand-title{\r\n      text-align: center;\r\n      font-weight: 700;\r\n      line-height: 1.3;\r\n    }\r\n    .brand-title .title-line-1{ font-size: 16px; }\r\n    .brand-title .title-line-2{ font-size: 14px; }\r\n    .brand-title .periode{ font-size: 12px; margin-top: 2px; }\r\n\r\n    /* kanan (meta) */\r\n    .meta{\r\n      font-size: 10px;\r\n      text-align: right;\r\n      line-height: 1.25;\r\n    }\r\n\r\n    /* ====== Section info kecil di bawah header ====== */\r\n    .section{\r\n      display: flex;\r\n      align-items: baseline;\r\n      gap: 8px;\r\n      margin: 6px 0 8px;\r\n      font-size: 11px;\r\n    }\r\n    .section .label{ font-weight: 700; }\r\n    .section .underline{\r\n      flex: 1;\r\n      border-bottom: 1px solid #000;\r\n      margin-left: 6px;\r\n    }\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n  <!-- Header -->\r\n  <div class=\"page-header\">\r\n    <div class=\"brand\">\r\n      <img src=\"{{asset 'template pdf/assets/Logo BPJS Ketenagakerjaan.png' 'dataURI'}}\" alt=\"BPJS Ketenagakerjaan\" class=\"brand-logo\" />\r\n      <div class=\"brand-title\">\r\n        <div class=\"title-line-1\">{{reportInfo.title}}</div>\r\n        <div class=\"title-line-2\">Provinsi: {{reportInfo.province}}</div>\r\n        <div class=\"periode\">Periode: {{reportInfo.period}}</div>\r\n      </div>\r\n    </div>\r\n    <div class=\"meta\">\r\n      <div class=\"meta-row\">Tanggal Cetak : {{printDate}}</div>\r\n      <div class=\"meta-row\">Waktu Cetak : {{printTime}}</div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Section -->\r\n  <div class=\"section\">\r\n    <div class=\"label\">NAMA KANTOR :</div>\r\n    <div class=\"value\">KANTOR PUSAT</div>\r\n    <div class=\"underline\"></div>\r\n  </div>\r\n\r\n  <!-- Table -->\r\n  <table>\r\n    <colgroup>\r\n      <col class=\"idx\">\r\n      <col class=\"prov\">\r\n      <!-- DAPODIK NON ASN NEGERI -->\r\n      <col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"sub\">\r\n      <!-- DAPODIK SWASTA -->\r\n      <col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"sub\">\r\n      <!-- BPJS NON ASN NEGERI -->\r\n      <col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"sub\">\r\n      <!-- BPJS SWASTA -->\r\n      <col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"sub\">\r\n      <!-- % NON ASN NEGERI -->\r\n      <col class=\"num percent\"><col class=\"num percent\"><col class=\"num percent\"><col class=\"sub percent\">\r\n      <!-- % SWASTA -->\r\n      <col class=\"num percent\"><col class=\"num percent\"><col class=\"num percent\"><col class=\"sub percent\">\r\n    </colgroup>\r\n\r\n    <thead>\r\n      <tr>\r\n        <th rowspan=\"3\">No</th>\r\n        <th rowspan=\"3\">Nama Kabupaten/Kota</th>\r\n        <th colspan=\"8\">JUMLAH GTK DAPODIK KEMENDIKBUD</th>\r\n        <th colspan=\"8\">JUMLAH GTK TERDAFTAR BPJS KETENAGAKERJAAN</th>\r\n        <th class=\"percent\" colspan=\"8\">% Kepesertaan Aktif</th>\r\n      </tr>\r\n      <tr>\r\n        <th colspan=\"4\">NON ASN NEGERI</th>\r\n        <th colspan=\"4\">SWASTA</th>\r\n        <th colspan=\"4\">NON ASN NEGERI</th>\r\n        <th colspan=\"4\">SWASTA</th>\r\n        <th class=\"percent\" colspan=\"4\">NON ASN NEGERI</th>\r\n        <th class=\"percent\" colspan=\"4\">SWASTA</th>\r\n      </tr>\r\n      <tr>\r\n        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>\r\n        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>\r\n        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>\r\n        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>\r\n        <th class=\"percent\">SMA</th><th class=\"percent\">SMK</th><th class=\"percent\">SLB</th><th class=\"percent\">Subtotal</th>\r\n        <th class=\"percent\">SMA</th><th class=\"percent\">SMK</th><th class=\"percent\">SLB</th><th class=\"percent\">Subtotal</th>\r\n      </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n      {{#each data}}\r\n      <tr>\r\n        <td>{{no}}</td>\r\n        <td class=\"wrap\">{{kabupatenKota}}</td>\r\n\r\n        <!-- DAPODIK NON ASN NEGERI -->\r\n        <td>{{formatID dapodikData.sma}}</td>\r\n        <td>{{formatID dapodikData.smk}}</td>\r\n        <td>{{formatID dapodikData.slb}}</td>\r\n        <td>{{formatID dapodikData.subtotal}}</td>\r\n\r\n        <!-- DAPODIK SWASTA -->\r\n        <td>{{formatID dapodikDataSwasta.sma}}</td>\r\n        <td>{{formatID dapodikDataSwasta.smk}}</td>\r\n        <td>{{formatID dapodikDataSwasta.slb}}</td>\r\n        <td>{{formatID dapodikDataSwasta.subtotal}}</td>\r\n\r\n        <!-- BPJS TERDAFTAR NON ASN NEGERI -->\r\n        <td>{{formatID bpjsData.nonAsnNegeri.sma}}</td>\r\n        <td>{{formatID bpjsData.nonAsnNegeri.smk}}</td>\r\n        <td>{{formatID bpjsData.nonAsnNegeri.slb}}</td>\r\n        <td>{{formatID bpjsData.nonAsnNegeri.subtotal}}</td>\r\n\r\n        <!-- BPJS TERDAFTAR SWASTA -->\r\n        <td>{{formatID bpjsData.swasta.sma}}</td>\r\n        <td>{{formatID bpjsData.swasta.smk}}</td>\r\n        <td>{{formatID bpjsData.swasta.slb}}</td>\r\n        <td>{{formatID bpjsData.swasta.subtotal}}</td>\r\n\r\n        <!-- % AKTIF NON ASN NEGERI -->\r\n        <td class=\"percent\">{{formatPercent participationRates.nonAsnNegeri.sma digits=2}}</td>\r\n        <td class=\"percent\">{{formatPercent participationRates.nonAsnNegeri.smk digits=2}}</td>\r\n        <td class=\"percent\">{{formatPercent participationRates.nonAsnNegeri.slb digits=2}}</td>\r\n        <td class=\"percent\">{{formatPercent participationRates.nonAsnNegeri.subtotal digits=2}}</td>\r\n\r\n        <!-- % AKTIF SWASTA -->\r\n        <td class=\"percent\">{{formatPercent participationRates.swasta.sma digits=2}}</td>\r\n        <td class=\"percent\">{{formatPercent participationRates.swasta.smk digits=2}}</td>\r\n        <td class=\"percent\">{{formatPercent participationRates.swasta.slb digits=2}}</td>\r\n        <td class=\"percent\">{{formatPercent participationRates.swasta.subtotal digits=2}}</td>\r\n      </tr>\r\n      {{/each}}\r\n    </tbody>\r\n\r\n    <tfoot>\r\n      <tr class=\"row-total\">\r\n        <td colspan=\"2\">TOTAL / RATA-RATA</td>\r\n\r\n        <!-- TOTAL DAPODIK NON ASN NEGERI -->\r\n        <td>{{formatID summary.totalDapodikNonAsnNegeri.sma}}</td>\r\n        <td>{{formatID summary.totalDapodikNonAsnNegeri.smk}}</td>\r\n        <td>{{formatID summary.totalDapodikNonAsnNegeri.slb}}</td>\r\n        <td>{{formatID summary.totalDapodikNonAsnNegeri.subtotal}}</td>\r\n\r\n        <!-- TOTAL DAPODIK SWASTA -->\r\n        <td>{{formatID summary.totalDapodikSwasta.sma}}</td>\r\n        <td>{{formatID summary.totalDapodikSwasta.smk}}</td>\r\n        <td>{{formatID summary.totalDapodikSwasta.slb}}</td>\r\n        <td>{{formatID summary.totalDapodikSwasta.subtotal}}</td>\r\n\r\n        <!-- TOTAL BPJS TERDAFTAR NON ASN NEGERI -->\r\n        <td>{{formatID summary.totalBpjs.nonAsnNegeri.sma}}</td>\r\n    