{"type":"error","timestamp":1757858744090,"entity":{"shortid":"OVhwooQhp","name":"pdf","content":"<!DOCTYPE html>\r\n<html lang=\"id\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <title>REKAP GTK PER PROVINSI</title>\r\n  <style>\r\n  /* ====== Halaman ====== */\r\n  @page { size: A4 landscape; margin: 6mm; }\r\n  html, body { margin: 0; font-size: 8.4px; }\r\n\r\n  /* ====== Tabel ====== */\r\n  table { width: 100%; border-collapse: collapse; table-layout: fixed; }\r\n  th, td {\r\n    border: 0.6px solid #cfcfcf;\r\n    padding: 2px 3px;\r\n    vertical-align: middle;\r\n    text-align: center;       /* semua isi tabel rata tengah */\r\n  }\r\n  th {\r\n    background: #f6f6f6;\r\n    line-height: 1.2;\r\n  }\r\n\r\n  /* kolom nama tetap kiri */\r\n  td.wrap { white-space: normal; text-align: left; }\r\n\r\n  /* zebra halus */\r\n  tbody tr:nth-child(odd) td { background: #fbfbfb; }\r\n\r\n  /* ====== Kolom ====== */\r\n  col.idx  { width: 24px; }\r\n  col.prov { width: 140px; }\r\n  col.num  { width: 34px; }\r\n  col.sub  { width: 48px; }\r\n\r\n  /* persen */\r\n  td.percent, th.percent { font-size: 8.2px; padding: 2px; }\r\n  col.num.percent { width: 38px; }\r\n  col.sub.percent { width: 46px; }\r\n\r\n  /* pemisah */\r\n  .sep-r { border-right: 0.6px solid #cfcfcf !important; }\r\n\r\n  /* Total */\r\n  tfoot { display: table-row-group; }\r\n  .row-total { font-weight: 700; background: #efefef; }\r\n\r\n  /* Footer */\r\n  .page-footer {\r\n    margin-top: 4mm;\r\n    display: flex; justify-content: space-between;\r\n    font-size: 9px; color: #444;\r\n  }\r\n  </style>\r\n\r\n  <script>\r\n    // Format angka ribuan Indonesia\r\n    function fmtID(num) {\r\n      if (num == null || num === '' || isNaN(num)) return '0';\r\n      return Number(num).toLocaleString('id-ID');\r\n    }\r\n    // Format persen Indonesia\r\n    function fmtPercent(num, digits=2) {\r\n      if (num == null || num === '' || isNaN(num)) {\r\n        return (0).toLocaleString('id-ID', {\r\n          minimumFractionDigits: digits,\r\n          maximumFractionDigits: digits\r\n        }) + '%';\r\n      }\r\n      return Number(num).toLocaleString('id-ID', {\r\n        minimumFractionDigits: digits,\r\n        maximumFractionDigits: digits\r\n      }) + '%';\r\n    }\r\n  </script>\r\n</head>\r\n<body>\r\n\r\n  <!-- Header -->\r\n  <div class=\"page-header\">\r\n    <div class=\"brand\">\r\n      <img src=\"{{asset 'template pdf/assets/Logo BPJS Ketenagakerjaan.png' 'dataURI'}}\"\r\n           alt=\"BPJS Ketenagakerjaan\" class=\"brand-logo\" />\r\n      <div class=\"brand-title\">\r\n        <div class=\"title-line-1\">REKAP GTK PER PROVINSI</div>\r\n        <div class=\"title-line-2\">(PAUD, TK, SD, SMP)</div>\r\n        <div class=\"periode\">Periode: {{period}}</div>\r\n      </div>\r\n    </div>\r\n    <div class=\"meta\">\r\n      <div class=\"meta-row\">Halaman : 1/1</div>\r\n      <div class=\"meta-row\">Tanggal Cetak : {{printDate}}</div>\r\n      <div class=\"meta-row\">Waktu Cetak : {{printTime}}</div>\r\n    </div>\r\n  </div>\r\n\r\n  <table>\r\n    <colgroup>\r\n      <col class=\"idx\">\r\n      <col class=\"prov\">\r\n\r\n      <!-- DAPODIK NON ASN NEGERI -->\r\n      <col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"sub sep-r\">\r\n\r\n      <!-- DAPODIK SWASTA -->\r\n      <col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"sub sep-r\">\r\n\r\n      <!-- BPJS NON ASN NEGERI -->\r\n      <col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"sub sep-r\">\r\n\r\n      <!-- BPJS SWASTA -->\r\n      <col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"sub sep-r\">\r\n\r\n      <!-- % NON ASN NEGERI -->\r\n      <col class=\"num percent\"><col class=\"num percent\"><col class=\"num percent\"><col class=\"num percent\"><col class=\"sub percent sep-r\">\r\n\r\n      <!-- % SWASTA -->\r\n      <col class=\"num percent\"><col class=\"num percent\"><col class=\"num percent\"><col class=\"num percent\"><col class=\"sub percent\">\r\n    </colgroup>\r\n\r\n    <thead>\r\n      <tr>\r\n        <th rowspan=\"3\">No</th>\r\n        <th rowspan=\"3\">Nama Provinsi</th>\r\n        <th colspan=\"10\">JUMLAH GTK DAPODIK KEMENDIKBUD</th>\r\n        <th colspan=\"10\">JUMLAH GTK TERDAFTAR BPJS KETENAGAKERJAAN</th>\r\n        <th class=\"percent\" colspan=\"10\">% Kepesertaan Aktif</th>\r\n      </tr>\r\n      <tr>\r\n        <th colspan=\"5\">NON ASN NEGERI</th>\r\n        <th colspan=\"5\">SWASTA</th>\r\n        <th colspan=\"5\">NON ASN NEGERI</th>\r\n        <th colspan=\"5\">SWASTA</th>\r\n        <th class=\"percent\" colspan=\"5\">NON ASN NEGERI</th>\r\n        <th class=\"percent\" colspan=\"5\">SWASTA</th>\r\n      </tr>\r\n      <tr>\r\n        <th>PAUD</th><th>TK</th><th>SD</th><th>SMP</th><th>Subtotal</th>\r\n        <th>PAUD</th><th>TK</th><th>SD</th><th>SMP</th><th>Subtotal</th>\r\n        <th>PAUD</th><th>TK</th><th>SD</th><th>SMP</th><th>Subtotal</th>\r\n        <th>PAUD</th><th>TK</th><th>SD</th><th>SMP</th><th>Subtotal</th>\r\n        <th class=\"percent\">PAUD</th><th class=\"percent\">TK</th><th class=\"percent\">SD</th><th class=\"percent\">SMP</th><th class=\"percent\">Subtotal</th>\r\n        <th class=\"percent\">PAUD</th><th class=\"percent\">TK</th><th class=\"percent\">SD</th><th class=\"percent\">SMP</th><th class=\"percent\">Subtotal</th>\r\n      </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n      {{#each provinces}}\r\n      <tr>\r\n        <td>{{index}}</td>\r\n        <td class=\"wrap\">{{province}}</td>\r\n\r\n        <!-- DAPODIK NON ASN NEGERI -->\r\n        <td><script>document.write(fmtID({{dapodik.nonAsnNegeri.paud}}))</script></td>\r\n        <td><script>document.write(fmtID({{dapodik.nonAsnNegeri.tk}}))</script></td>\r\n        <td><script>document.write(fmtID({{dapodik.nonAsnNegeri.sd}}))</script></td>\r\n        <td><script>document.write(fmtID({{dapodik.nonAsnNegeri.smp}}))</script></td>\r\n        <td class=\"sep-r\"><script>document.write(fmtID({{dapodik.nonAsnNegeri.subtotal}}))</script></td>\r\n\r\n        <!-- DAPODIK SWASTA -->\r\n        <td><script>document.write(fmtID({{dapodik.swasta.paud}}))</script></td>\r\n        <td><script>document.write(fmtID({{dapodik.swasta.tk}}))</script></td>\r\n        <td><script>document.write(fmtID({{dapodik.swasta.sd}}))</script></td>\r\n        <td><script>document.write(fmtID({{dapodik.swasta.smp}}))</script></td>\r\n        <td class=\"sep-r\"><script>document.write(fmtID({{dapodik.swasta.subtotal}}))</script></td>\r\n\r\n        <!-- BPJS NON ASN NEGERI -->\r\n        <td><script>document.write(fmtID({{bpjsTerdaftar.nonAsnNegeri.paud}}))</script></td>\r\n        <td><script>document.write(fmtID({{bpjsTerdaftar.nonAsnNegeri.tk}}))</script></td>\r\n        <td><script>document.write(fmtID({{bpjsTerdaftar.nonAsnNegeri.sd}}))</script></td>\r\n        <td><script>document.write(fmtID({{bpjsTerdaftar.nonAsnNegeri.smp}}))</script></td>\r\n        <td class=\"sep-r\"><script>document.write(fmtID({{bpjsTerdaftar.nonAsnNegeri.subtotal}}))</script></td>\r\n\r\n        <!-- BPJS SWASTA -->\r\n        <td><script>document.write(fmtID({{bpjsTerdaftar.swasta.paud}}))</script></td>\r\n        <td><script>document.write(fmtID({{bpjsTerdaftar.swasta.tk}}))</script></td>\r\n        <td><script>document.write(fmtID({{bpjsTerdaftar.swasta.sd}}))</script></td>\r\n        <td><script>document.write(fmtID({{bpjsTerdaftar.swasta.smp}}))</script></td>\r\n        <td class=\"sep-r\"><script>document.write(fmtID({{bpjsTerdaftar.swasta.subtotal}}))</script></td>\r\n\r\n        <!-- % AKTIF NON ASN NEGERI -->\r\n        <td class=\"percent\"><script>document.write(fmtPercent({{aktifPercent.nonAsnNegeri.paud}}))</script></td>\r\n        <td class=\"percent\"><script>document.write(fmtPercent({{aktifPercent.nonAsnNegeri.tk}}))</script></td>\r\n        <td class=\"percent\"><