{"type":"error","timestamp":1757855175394,"entity":{"shortid":"qlMZENvLa","name":"File_1","content":"<!DOCTYPE html>\r\n<html lang=\"id\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <title>REKAP GTK PER PROVINSI</title>\r\n  <style>\r\n    /* ====== A4 landscape & tata letak ====== */\r\n    @page { size: A4 landscape; margin: 8mm; }\r\n    html, body { margin: 0; }\r\n\r\n    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 9.5px; }\r\n    th, td { border: 1px solid #000; padding: 3px 4px; text-align: right; vertical-align: middle; }\r\n\r\n    /* Header tabel boleh wrap */\r\n    thead th {\r\n      white-space: normal; word-break: break-word; line-height: 1.15;\r\n      font-size: 9px; background: #f8f8f8;\r\n    }\r\n\r\n    /* Angka rapi, tak membungkus */\r\n    td { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; }\r\n\r\n    /* Kolom teks (nama provinsi) boleh wrap */\r\n    td.wrap { white-space: normal; text-align: left; }\r\n\r\n    /* Lebar kolom dasar */\r\n    col.idx  { width: 28px; }\r\n    col.prov { width: 170px; }\r\n    col.num  { width: 45px; }\r\n    col.sub  { width: 54px; }\r\n\r\n    /* Khusus kolom persen: sedikit lebih lebar + font kecil */\r\n    td.percent, th.percent { font-size: 8px; padding: 2px; }\r\n    col.num.percent { width: 52px; }\r\n    col.sub.percent { width: 60px; }\r\n\r\n    /* Total di akhir & hindari pecah halaman */\r\n    tfoot { display: table-row-group; }\r\n    .row-total { font-weight: 700; background: #f0f0f0; page-break-inside: avoid; }\r\n\r\n    /* Footer hanya di akhir, bukan fixed */\r\n    .page-footer {\r\n      margin-top: 8mm;\r\n      display: flex; justify-content: space-between;\r\n      font-size: 10px; color: #444;\r\n    }\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n  <!-- Header -->\r\n  <div class=\"page-header\">\r\n    <div class=\"brand\">\r\n      <img src=\"{{asset 'template pdf/assets/Logo BPJS Ketenagakerjaan.png' 'dataURI'}}\" alt=\"BPJS Ketenagakerjaan\" class=\"brand-logo\" />\r\n      <div class=\"brand-title\">\r\n        <div class=\"title-line-1\">REKAP GTK PER PROVINSI</div>\r\n        <div class=\"title-line-2\">(SMA, SMK, SLB)</div>\r\n        <div class=\"periode\">Periode: {{period}}</div>\r\n      </div>\r\n    </div>\r\n    <div class=\"meta\">\r\n      <div class=\"meta-row\">Halaman : 1/1</div>\r\n      <div class=\"meta-row\">Tanggal Cetak : {{printDate}}</div>\r\n      <div class=\"meta-row\">Waktu Cetak : {{printTime}}</div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Section -->\r\n  <div class=\"section\">\r\n    <div class=\"label\">NAMA KANTOR :</div>\r\n    <div class=\"value\">KANTOR PUSAT</div>\r\n    <div class=\"underline\"></div>\r\n  </div>\r\n\r\n  <!-- Table -->\r\n  <table>\r\n    <!-- Kontrol lebar kolom -->\r\n    <colgroup>\r\n      <col class=\"idx\">\r\n      <col class=\"prov\">\r\n      <!-- DAPODIK NON ASN NEGERI -->\r\n      <col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"sub\">\r\n      <!-- DAPODIK SWASTA -->\r\n      <col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"sub\">\r\n      <!-- BPJS NON ASN NEGERI -->\r\n      <col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"sub\">\r\n      <!-- BPJS SWASTA -->\r\n      <col class=\"num\"><col class=\"num\"><col class=\"num\"><col class=\"sub\">\r\n      <!-- % NON ASN NEGERI -->\r\n      <col class=\"num percent\"><col class=\"num percent\"><col class=\"num percent\"><col class=\"sub percent\">\r\n      <!-- % SWASTA -->\r\n      <col class=\"num percent\"><col class=\"num percent\"><col class=\"num percent\"><col class=\"sub percent\">\r\n    </colgroup>\r\n\r\n    <thead>\r\n      <tr>\r\n        <th rowspan=\"3\">No</th>\r\n        <th rowspan=\"3\">Nama Provinsi</th>\r\n        <th colspan=\"8\">JUMLAH GTK DAPODIK KEMENDIKBUD</th>\r\n        <th colspan=\"8\">JUMLAH GTK TERDAFTAR BPJS KETENAGAKERJAAN</th>\r\n        <th class=\"percent\" colspan=\"8\">% Kepesertaan Aktif</th>\r\n      </tr>\r\n      <tr>\r\n        <th colspan=\"4\">NON ASN NEGERI</th>\r\n        <th colspan=\"4\">SWASTA</th>\r\n        <th colspan=\"4\">NON ASN NEGERI</th>\r\n        <th colspan=\"4\">SWASTA</th>\r\n        <th class=\"percent\" colspan=\"4\">NON ASN NEGERI</th>\r\n        <th class=\"percent\" colspan=\"4\">SWASTA</th>\r\n      </tr>\r\n      <tr>\r\n        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>\r\n        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>\r\n        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>\r\n        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>\r\n        <th class=\"percent\">SMA</th><th class=\"percent\">SMK</th><th class=\"percent\">SLB</th><th class=\"percent\">Subtotal</th>\r\n        <th class=\"percent\">SMA</th><th class=\"percent\">SMK</th><th class=\"percent\">SLB</th><th class=\"percent\">Subtotal</th>\r\n      </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n      {{#each provinces}}\r\n      <tr>\r\n        <td>{{index}}</td>\r\n        <td class=\"wrap\">{{province}}</td>\r\n\r\n        <!-- DAPODIK NON ASN NEGERI -->\r\n        <td>{{formatID dapodik.nonAsnNegeri.sma}}</td>\r\n        <td>{{formatID dapodik.nonAsnNegeri.smk}}</td>\r\n        <td>{{formatID dapodik.nonAsnNegeri.slb}}</td>\r\n        <td>{{formatID dapodik.nonAsnNegeri.subtotal}}</td>\r\n\r\n        <!-- DAPODIK SWASTA -->\r\n        <td>{{formatID dapodik.swasta.sma}}</td>\r\n        <td>{{formatID dapodik.swasta.smk}}</td>\r\n        <td>{{formatID dapodik.swasta.slb}}</td>\r\n        <td>{{formatID dapodik.swasta.subtotal}}</td>\r\n\r\n        <!-- BPJS TERDAFTAR NON ASN NEGERI -->\r\n        <td>{{formatID bpjsTerdaftar.nonAsnNegeri.sma}}</td>\r\n        <td>{{formatID bpjsTerdaftar.nonAsnNegeri.smk}}</td>\r\n        <td>{{formatID bpjsTerdaftar.nonAsnNegeri.slb}}</td>\r\n        <td>{{formatID bpjsTerdaftar.nonAsnNegeri.subtotal}}</td>\r\n\r\n        <!-- BP