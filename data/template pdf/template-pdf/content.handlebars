<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <title>REKAP GTK PER PROVINSI</title>
  <style>
    @page { size: A4 landscape; margin: 16mm 12mm 16mm 12mm; }
    html, body { margin: 0; padding: 0; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #000; }

    /* Header */
    .page-header {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .brand-logo {
      width: 210px;
      height: 70px;
      object-fit: contain;
    }
    .brand-title {
      font-weight: bold;
      text-align: center;
      width: 100%;
    }
    .brand-title .title-line-1 { font-weight: 700; }
    .brand-title .title-line-2 { font-weight: 700; }
    .brand-title .periode { margin-top: 2px; }

    .meta {
      line-height: 1.25;
      text-align: right;
      font-size: 11px;
    }
    .meta-row { white-space: nowrap; }

    /* Section */
    .section {
      margin-top: 8px;
      margin-bottom: 6px;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 8px;
      align-items: center;
    }
    .section .label { font-weight: bold; }
    .section .value { font-weight: 600; }
    .section .underline {
      grid-column: 1 / -1;
      height: 2px;
      background: #1e90ff;
      margin-top: 6px;
      margin-bottom: 2px;
      border-radius: 2px;
    }

    /* Table */
    table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }
    thead th {
      background: #efefef;
      font-weight: 700;
      border: 1px solid #cfcfcf;
      padding: 5px 6px;
      text-align: center;
      font-size: 10px;
    }
    tbody td {
      border: 1px solid #d9d9d9;
      padding: 5px 6px;
      vertical-align: middle;
      font-size: 10px;
      text-align: center;
    }
    tbody td:first-child, 
    thead th:first-child { text-align: center; width: 30px; }
    tbody td:nth-child(2), 
    thead th:nth-child(2) { text-align: left; width: 140px; }

    /* Footer */
    .page-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 8px;
      font-size: 11px;
    }
    .code-left { font-weight: 600; }
    .code-right {
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 10px;
      border: 2px solid #27ae60;
      color: #27ae60;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <div class="page-header">
    <div class="brand">
      <img src="{{asset "Logo BPJS Ketenagakerjaan.png" "dataURI"}}" alt="BPJS Ketenagakerjaan" class="brand-logo" />
      <div class="brand-title">
        <div class="title-line-1">REKAP GTK PER PROVINSI</div>
        <div class="title-line-2">SEMUA JENIS KEPEGAWAIAN</div>
        <div class="periode">Periode: 01-07-2025</div>
      </div>
    </div>
    <div class="meta">
      <div class="meta-row">Halaman : 1/1</div>
      <div class="meta-row">Tanggal Cetak : 09-09-2025</div>
      <div class="meta-row">Waktu Cetak : 15:45</div>
    </div>
  </div>

  <!-- Section -->
  <div class="section">
    <div class="label">NAMA KANTOR :</div>
    <div class="value">KANTOR PUSAT</div>
    <div class="underline"></div>
  </div>

  <!-- Table -->
  <table>
    <thead>
      <tr>
        <th rowspan="3">No</th>
        <th rowspan="3">Nama Provinsi</th>
        <th colspan="5">Jumlah GTK</th>
        <th colspan="5">GTK Terdaftar BPJS Ketenagakerjaan</th>
        <th colspan="5">% Kepesertaan Aktif</th>
      </tr>
      <tr>
        <th rowspan="2">ASN</th>
        <th rowspan="2">PPPK</th>
        <th colspan="2">NON ASN</th>
        <th rowspan="2">Sub Total</th>
        <th rowspan="2">ASN</th>
        <th rowspan="2">PPPK</th>
        <th colspan="2">NON ASN</th>
        <th rowspan="2">Sub Total</th>
        <th rowspan="2">ASN</th>
        <th rowspan="2">PPPK</th>
        <th colspan="2">NON ASN</th>
        <th rowspan="2">Sub Total</th>
      </tr>
      <tr>
        <th>Negeri</th><th>Swasta</th>
        <th>Negeri</th><th>Swasta</th>
        <th>Negeri</th><th>Swasta</th>
      </tr>
    </thead>
    <tbody>
      {{#each data}}
      <tr>
        <td>{{No}}</td>
        <td>{{Provinsi}}</td>
        <td>{{Jumlah.ASN}}</td>
        <td>{{Jumlah.PPPK}}</td>
        <td>{{Jumlah.Non_ASN.Negeri}}</td>
        <td>{{Jumlah.Non_ASN.Swasta}}</td>
        <td>{{Jumlah.Subtotal}}</td>
        <td>{{BPJS.ASN}}</td>
        <td>{{BPJS.PPPK}}</td>
        <td>{{BPJS.Non_ASN.Negeri}}</td>
        <td>{{BPJS.Non_ASN.Swasta}}</td>
        <td>{{BPJS.Subtotal}}</td>
        <td>{{Kepesertaan_Aktif.ASN}}</td>
        <td>{{Kepesertaan_Aktif.PPPK}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Negeri}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Swasta}}</td>
        <td>{{Kepesertaan_Aktif.Subtotal}}</td>
      </tr>
      {{/each}}
      <!-- Baris Total -->
      <tr style="font-weight: bold; background-color: #f0f0f0;">
        <td colspan="2">TOTAL</td>
        <td>{{summary.totalJumlahASN}}</td>
        <td>{{summary.totalJumlahPPPK}}</td>
        <td>{{summary.totalJumlahNonASNNegeri}}</td>
        <td>{{summary.totalJumlahNonASNSwasta}}</td>
        <td>{{summary.totalJumlahSubtotal}}</td>
        <td>{{summary.totalBPJSASN}}</td>
        <td>{{summary.totalBPJSPPPK}}</td>
        <td>{{summary.totalBPJSNonASNNegeri}}</td>
        <td>{{summary.totalBPJSNonASNSwasta}}</td>
        <td>{{summary.totalBPJSSubtotal}}</td>
        <td>{{summary.avgKepesertaanASN}}</td>
        <td>{{summary.avgKepesertaanPPPK}}</td>
        <td>{{summary.avgKepesertaanNonASNNegeri}}</td>
        <td>{{summary.avgKepesertaanNonASNSwasta}}</td>
        <td>{{summary.avgKepesertaanSubtotal}}</td>
      </tr>
    </tbody>
  </table>

  <!-- Footer -->
  <div class="page-footer">
    <div class="code-left">REKAP 2025</div>
    <div class="code-right">KNODIK003</div>
  </div>

</body>
</html>
