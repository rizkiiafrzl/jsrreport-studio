{{{xlsxPrint}}}
<style>
  table { width:100%; border-collapse:collapse; table-layout:fixed; font-family: Arial, Helvetica, sans-serif; }
  table, th, td { font-size:10pt !important; }
  th { padding:3px 4px; border:1px solid #cfcfcf; text-align:center; vertical-align:middle; white-space: nowrap; }
  td { padding:3px 4px; border:1px solid #cfcfcf; vertical-align:middle; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  thead th { background:#f5f5f5; font-weight:700; }
  thead th.title-lite { font-weight: 400; }

  /* Title rows */
  .title { background:#fff; font-size:12px; text-align:left; }
  .title-center { text-align:center; }
  .title-right { text-align:right; }

  /* Numeric / alignment helpers */
  .text-left { text-align:left; }
  .text-right { text-align:right; }
  .text-center { text-align:center; }

  /* Specific column widths */
  .col-no { width:16px; max-width:16px; text-align:center; }
  .col-prov { width:200px; }
  .col-kab { width:140px; }
  .col-sekolah { width:250px; }
  .col-jumlah-gtk { width:12px; text-align:center; }
  .col-bpjs { width:60px; min-width:60px; max-width:60px; text-align:center; }
  .col-belum-terdaftar { width:180px; min-width:60px; max-width:180px; text-align:center; }
  .col-persen { width:120px; min-width:60px; max-width:120px; text-align:center; }
  .col-alamat { width:400px; min-width:360px; max-width:500px; }
  .col-email { width:250px; min-width:250px; max-width:250px; }
  .col-hp { width:120px; min-width:120px; max-width:120px; text-align:center; }

  /* Special cells */
  .subtotal { background:#f0f0f0; font-weight:bold; }
  .cell-no {
    padding-left:1px !important;
    padding-right:1px !important;
    max-width:16px !important;
    overflow:hidden !important;
    text-overflow:clip !important;
    white-space:nowrap !important;
  }

  /* Text transforms */
  .uppercase { text-transform: uppercase; }
  .lowercase { text-transform: lowercase; }
</style>

<table>
  <colgroup>
    <col class="col-no" />
    <col class="col-prov" />
    <col class="col-kab" />
    <col class="col-sekolah" />
    <col class="col-jumlah-gtk" />
    <col class="col-bpjs" />
    <col class="col-belum-terdaftar" />
    <col class="col-persen" />
    <col class="col-alamat" />
    <col class="col-email" />
    <col class="col-hp" />
  </colgroup>

  <thead>
    <tr>
      <th colspan="11" class="title title-lite title-right">{{@root.code}}</th>
    </tr>
    <tr>
      <th colspan="11" class="title title-center">{{@root.title}} ({{@root.subtitle}})</th>
    </tr>
    <tr>
      <th colspan="11" class="title title-lite title-right">Periode: {{@root.period}}</th>
    </tr>
    <tr>
      <th class="cell-no" rowspan="2">NO</th>
      <th rowspan="2">NAMA PROVINSI</th>
      <th rowspan="2">NAMA KAB KOTA</th>
      <th rowspan="2">NAMA SATUAN PENDIDIKAN</th>
      <th colspan="7">PTK DAPODIK</th>
    </tr>
    <tr>
      <th>JUMLAH GTK</th>
      <th>TERDAFTAR BPJS KETENAGAKERJAAN</th>
      <th>PTK BELUM TERDAFTAR</th>
      <th>% TERDAFTAR</th>
      <th>ALAMAT</th>
      <th>EMAIL</th>
      <th>NO HP</th>
    </tr>
  </thead>

  <tbody>
    {{#each data}}
    <tr>
      <td class="col-no">{{No}}</td>
      <td class="text-left">{{Provinsi}}</td>
      <td class="text-left">{{Kabupaten_Kota}}</td>
      <td class="text-left">{{Nama_Satuan_Pendidikan}}</td>
      <td class="col-jumlah-gtk">{{PTK_Dapodik}}</td>
      <td class="col-bpjs">{{Terdaftar_BPJS}}</td>
      <td class="col-belum-terdaftar">{{Belum_Terdaftar}}</td>
      <td class="col-persen">{{Persen_Terdaftar}}</td>
      <td class="col-alamat text-left uppercase">{{Alamat}}</td>
      <td class="col-email text-left lowercase">{{Email}}</td>
      <td class="col-hp">{{No_HP}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>
