<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <title>{{@root.title}}</title>
  <style>
    {{ asset "assets/style.css" "utf8" }}
  </style>
</head>
<body>

  <!-- Header (sebaris: kiri - tengah - kanan) -->
  <div class="page-header">
    <!-- Logo kiri -->
    <div class="brand-left">
      <img src="{{asset 'assets/Logo BPJS Ketenagakerjaan.png' 'dataURI'}}" alt="BPJS Ketenagakerjaan" class="brand-logo" />
    </div>

    <!-- Judul tengah -->
    <div class="brand-title">
      <div class="title-line-1">{{@root.title}}</div>
      <div class="title-line-2">{{@root.subtitle}}</div>
      <div class="periode">Periode: {{@root.period}}</div>
    </div>

    <!-- Meta kanan -->
    <div class="meta">
      <div class="meta-row">Halaman : {{getPageNumber @index}} / {{getTotalPages $pdf.pages}}</div>
      <div class="meta-row">Tanggal Cetak : {{getFormattedDateWithTimezone}}</div>
    </div>
  </div>

  <!-- Section kecil -->
  <div class="section">
    <div class="label">NAMA KANTOR :</div>
    <div class="value">KANTOR PUSAT</div>
    <div class="underline"></div>
  </div>

  <!-- Table -->
  <table>
    <!-- Kontrol lebar kolom -->
    <colgroup>
      <col class="idx">
      <col class="prov">
      <!-- DAPODIK NON ASN NEGERI -->
      <col class="num"><col class="num"><col class="num"><col class="sub">
      <!-- DAPODIK SWASTA -->
      <col class="num"><col class="num"><col class="num"><col class="sub">
      <!-- BPJS NON ASN NEGERI -->
      <col class="num"><col class="num"><col class="num"><col class="sub">
      <!-- BPJS SWASTA -->
      <col class="num"><col class="num"><col class="num"><col class="sub">
      <!-- % NON ASN NEGERI -->
      <col class="num percent"><col class="num percent"><col class="num percent"><col class="sub percent">
      <!-- % SWASTA -->
      <col class="num percent"><col class="num percent"><col class="num percent"><col class="sub percent">
    </colgroup>

    <thead>
      <tr>
        <th rowspan="3">No</th>
        <th rowspan="3">Nama Provinsi</th>
        <th colspan="8">JUMLAH GTK DAPODIK KEMENDIKBUD</th>
        <th colspan="8">JUMLAH GTK TERDAFTAR BPJS KETENAGAKERJAAN</th>
        <th class="percent" colspan="8">% Kepesertaan Aktif</th>
      </tr>
      <tr>
        <th colspan="4">NON ASN NEGERI</th>
        <th colspan="4">SWASTA</th>
        <th colspan="4">NON ASN NEGERI</th>
        <th colspan="4">SWASTA</th>
        <th class="percent" colspan="4">NON ASN NEGERI</th>
        <th class="percent" colspan="4">SWASTA</th>
      </tr>
      <tr>
        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>
        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>
        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>
        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>
        <th class="percent">SMA</th><th class="percent">SMK</th><th class="percent">SLB</th><th class="percent">Subtotal</th>
        <th class="percent">SMA</th><th class="percent">SMK</th><th class="percent">SLB</th><th class="percent">Subtotal</th>
      </tr>
    </thead>

    <tbody>
      {{#each provinces}}
      <tr>
        <td>{{index}}</td>
        <td class="wrap">{{province}}</td>

        <!-- DAPODIK NON ASN NEGERI -->
        <td>{{formatID dapodik.nonAsnNegeri.sma}}</td>
        <td>{{formatID dapodik.nonAsnNegeri.smk}}</td>
        <td>{{formatID dapodik.nonAsnNegeri.slb}}</td>
        <td>{{formatID dapodik.nonAsnNegeri.subtotal}}</td>

        <!-- DAPODIK SWASTA -->
        <td>{{formatID dapodik.swasta.sma}}</td>
        <td>{{formatID dapodik.swasta.smk}}</td>
        <td>{{formatID dapodik.swasta.slb}}</td>
        <td>{{formatID dapodik.swasta.subtotal}}</td>

        <!-- BPJS TERDAFTAR NON ASN NEGERI -->
        <td>{{formatID bpjsTerdaftar.nonAsnNegeri.sma}}</td>
        <td>{{formatID bpjsTerdaftar.nonAsnNegeri.smk}}</td>
        <td>{{formatID bpjsTerdaftar.nonAsnNegeri.slb}}</td>
        <td>{{formatID bpjsTerdaftar.nonAsnNegeri.subtotal}}</td>

        <!-- BPJS TERDAFTAR SWASTA -->
        <td>{{formatID bpjsTerdaftar.swasta.sma}}</td>
        <td>{{formatID bpjsTerdaftar.swasta.smk}}</td>
        <td>{{formatID bpjsTerdaftar.swasta.slb}}</td>
        <td>{{formatID bpjsTerdaftar.swasta.subtotal}}</td>

        <!-- % AKTIF NON ASN NEGERI -->
        <td class="percent">{{formatPercent aktifPercent.nonAsnNegeri.sma digits=2}}</td>
        <td class="percent">{{formatPercent aktifPercent.nonAsnNegeri.smk digits=2}}</td>
        <td class="percent">{{formatPercent aktifPercent.nonAsnNegeri.slb digits=2}}</td>
        <td class="percent">{{formatPercent aktifPercent.nonAsnNegeri.subtotal digits=2}}</td>

        <!-- % AKTIF SWASTA -->
        <td class="percent">{{formatPercent aktifPercent.swasta.sma digits=2}}</td>
        <td class="percent">{{formatPercent aktifPercent.swasta.smk digits=2}}</td>
        <td class="percent">{{formatPercent aktifPercent.swasta.slb digits=2}}</td>
        <td class="percent">{{formatPercent aktifPercent.swasta.subtotal digits=2}}</td>
      </tr>
      {{/each}}
    </tbody>

    <tfoot>
      <tr class="row-total">
        <td colspan="2">TOTAL</td>

        <!-- TOTAL DAPODIK NON ASN NEGERI -->
        <td>{{formatID totals.dapodik.nonAsnNegeri.sma}}</td>
        <td>{{formatID totals.dapodik.nonAsnNegeri.smk}}</td>
        <td>{{formatID totals.dapodik.nonAsnNegeri.slb}}</td>
        <td>{{formatID totals.dapodik.nonAsnNegeri.subtotal}}</td>

        <!-- TOTAL DAPODIK SWASTA -->
        <td>{{formatID totals.dapodik.swasta.sma}}</td>
        <td>{{formatID totals.dapodik.swasta.smk}}</td>
        <td>{{formatID totals.dapodik.swasta.slb}}</td>
        <td>{{formatID totals.dapodik.swasta.subtotal}}</td>

        <!-- TOTAL BPJS TERDAFTAR NON ASN NEGERI -->
        <td>{{formatID totals.bpjsTerdaftar.nonAsnNegeri.sma}}</td>
        <td>{{formatID totals.bpjsTerdaftar.nonAsnNegeri.smk}}</td>
        <td>{{formatID totals.bpjsTerdaftar.nonAsnNegeri.slb}}</td>
        <td>{{formatID totals.bpjsTerdaftar.nonAsnNegeri.subtotal}}</td>

        <!-- TOTAL BPJS TERDAFTAR SWASTA -->
        <td>{{formatID totals.bpjsTerdaftar.swasta.sma}}</td>
        <td>{{formatID totals.bpjsTerdaftar.swasta.smk}}</td>
        <td>{{formatID totals.bpjsTerdaftar.swasta.slb}}</td>
        <td>{{formatID totals.bpjsTerdaftar.swasta.subtotal}}</td>

        <!-- RATA2 % AKTIF NON ASN NEGERI -->
        <td class="percent">{{formatPercent totals.aktifPercent.nonAsnNegeri.sma digits=2}}</td>
        <td class="percent">{{formatPercent totals.aktifPercent.nonAsnNegeri.smk digits=2}}</td>
        <td class="percent">{{formatPercent totals.aktifPercent.nonAsnNegeri.slb digits=2}}</td>
        <td class="percent">{{formatPercent totals.aktifPercent.nonAsnNegeri.subtotal digits=2}}</td>

        <!-- RATA2 % AKTIF SWASTA -->
        <td class="percent">{{formatPercent totals.aktifPercent.swasta.sma digits=2}}</td>
        <td class="percent">{{formatPercent totals.aktifPercent.swasta.smk digits=2}}</td>
        <td class="percent">{{formatPercent totals.aktifPercent.swasta.slb digits=2}}</td>
        <td class="percent">{{formatPercent totals.aktifPercent.swasta.subtotal digits=2}}</td>
      </tr>
    </tfoot>
  </table>

  <!-- Footer (muncul SEKALI di akhir dokumen) -->
  <div class="page-footer">
    <div class="code-left">REKAP {{year}}</div>
    <div class="code-right">{{@root.code}}</div>
  </div>

</body>
</html>
