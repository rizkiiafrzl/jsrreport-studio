<!-- Header -->
<div class="page-header">
  <div class="brand">
    <img src="{{asset 'assets/Logo BPJS Ketenagakerjaan.png' 'dataURI'}}" alt="BPJS Ketenagakerjaan" class="brand-logo" />
  </div>
  <div class="brand-title">
    <div class="title-line-1">REKAP GTK PER PROVINSI</div>
    <div class="title-line-2">(PAUD, TK, SD, SMP)</div>
    <div class="periode">Periode: {{period}}</div>
  </div>
  <div class="meta">
    <div class="meta-row">Halaman : 1/1</div>
    <div class="meta-row">Tanggal Cetak : {{printDate}}</div>
    <div class="meta-row">Waktu Cetak : {{printTime}}</div>
  </div>
</div>

<!-- Footer -->
<div class="page-footer">
  <div class="code-left">REKAP {{year}}</div>
  <div class="code-right">KNODIK007</div>
</div>


