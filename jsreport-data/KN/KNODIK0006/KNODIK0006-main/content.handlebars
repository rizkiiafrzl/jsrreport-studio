<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <title>{{reportInfo.title}}</title>
  <style>
    {{ asset "assets/style.css" "utf8" }}
  </style>
</head>
<body>

  <!-- Header (3 kolom sejajar) -->
  <div class="page-header">
    <!-- kiri: logo -->
    <div class="brand">
      <img src="{{asset 'assets/Logo BPJS Ketenagakerjaan.png' 'dataURI'}}" alt="BPJS Ketenagakerjaan" class="brand-logo" />
    </div>

    <!-- tengah: judul -->
    <div class="brand-title">
      <div class="title-line-1">{{reportInfo.title}}</div>
      <div class="title-line-2">PROVINSI: {{reportInfo.province}}</div>
      <div class="periode">PERIODE: {{reportInfo.period}}</div>
    </div>

    <!-- Meta kanan -->
    <div class="meta">
      <div class="meta-row">HALAMAN : {{getPageNumber @index}} / {{getTotalPages $pdf.pages}}</div>
      <div class="meta-row">TANGGAL CETAK : {{getFormattedDateWithTimezone}}</div>
    </div>
  </div>

  <!-- Section -->
  <div class="section">
    <div class="label">NAMA KANTOR :</div>
    <div class="value">KANTOR PUSAT</div>
  </div>

  <!-- Table -->
  <table>
    <colgroup>
      <col class="idx">
      <col class="prov">
      <!-- DAPODIK NON ASN NEGERI -->
      <col class="num"><col class="num"><col class="num"><col class="sub">
      <!-- DAPODIK SWASTA -->
      <col class="num"><col class="num"><col class="num"><col class="sub">
      <!-- BPJS NON ASN NEGERI -->
      <col class="num"><col class="num"><col class="num"><col class="sub">
      <!-- BPJS SWASTA -->
      <col class="num"><col class="num"><col class="num"><col class="sub">
      <!-- % NON ASN NEGERI -->
      <col class="num percent"><col class="num percent"><col class="num percent"><col class="sub percent">
      <!-- % SWASTA -->
      <col class="num percent"><col class="num percent"><col class="num percent"><col class="sub percent">
    </colgroup>

    <thead>
      <tr>
        <th rowspan="3">NO</th>
        <th rowspan="3">NAMA KABUPATEN/KOTA</th>
        <th colspan="8">JUMLAH GTK DAPODIK KEMENDIKBUD</th>
        <th colspan="8">JUMLAH GTK TERDAFTAR BPJS KETENAGAKERJAAN</th>
        <th class="percent" colspan="8">KEPESERTAAN AKTIF</th>
      </tr>
      <tr>
        <th colspan="4">NON ASN NEGERI</th>
        <th colspan="4">SWASTA</th>
        <th colspan="4">NON ASN NEGERI</th>
        <th colspan="4">SWASTA</th>
        <th class="percent" colspan="4">NON ASN NEGERI</th>
        <th class="percent" colspan="4">SWASTA</th>
      </tr>
      <tr>
        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>
        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>
        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>
        <th>SMA</th><th>SMK</th><th>SLB</th><th>Subtotal</th>
        <th class="percent">SMA</th><th class="percent">SMK</th><th class="percent">SLB</th><th class="percent">Subtotal</th>
        <th class="percent">SMA</th><th class="percent">SMK</th><th class="percent">SLB</th><th class="percent">Subtotal</th>
      </tr>
    </thead>

    <tbody>
      {{#each data}}
      <tr>
        <td>{{no}}</td>
        <td class="wrap">{{kabupatenKota}}</td>

        <!-- DAPODIK NON ASN NEGERI -->
        <td>{{#if dapodikData.sma}}{{dapodikData.sma}}{{else}}-{{/if}}</td>
        <td>{{#if dapodikData.smk}}{{dapodikData.smk}}{{else}}-{{/if}}</td>
        <td>{{#if dapodikData.slb}}{{dapodikData.slb}}{{else}}-{{/if}}</td>
        <td>{{#if dapodikData.subtotal}}{{dapodikData.subtotal}}{{else}}-{{/if}}</td>

        <!-- DAPODIK SWASTA -->
        <td>{{#if dapodikDataSwasta.sma}}{{dapodikDataSwasta.sma}}{{else}}-{{/if}}</td>
        <td>{{#if dapodikDataSwasta.smk}}{{dapodikDataSwasta.smk}}{{else}}-{{/if}}</td>
        <td>{{#if dapodikDataSwasta.slb}}{{dapodikDataSwasta.slb}}{{else}}-{{/if}}</td>
        <td>{{#if dapodikDataSwasta.subtotal}}{{dapodikDataSwasta.subtotal}}{{else}}-{{/if}}</td>

        <!-- BPJS TERDAFTAR NON ASN NEGERI -->
        <td>{{#if bpjsData.nonAsnNegeri.sma}}{{bpjsData.nonAsnNegeri.sma}}{{else}}-{{/if}}</td>
        <td>{{#if bpjsData.nonAsnNegeri.smk}}{{bpjsData.nonAsnNegeri.smk}}{{else}}-{{/if}}</td>
        <td>{{#if bpjsData.nonAsnNegeri.slb}}{{bpjsData.nonAsnNegeri.slb}}{{else}}-{{/if}}</td>
        <td>{{#if bpjsData.nonAsnNegeri.subtotal}}{{bpjsData.nonAsnNegeri.subtotal}}{{else}}-{{/if}}</td>

        <!-- BPJS TERDAFTAR SWASTA -->
        <td>{{#if bpjsData.swasta.sma}}{{bpjsData.swasta.sma}}{{else}}-{{/if}}</td>
        <td>{{#if bpjsData.swasta.smk}}{{bpjsData.swasta.smk}}{{else}}-{{/if}}</td>
        <td>{{#if bpjsData.swasta.slb}}{{bpjsData.swasta.slb}}{{else}}-{{/if}}</td>
        <td>{{#if bpjsData.swasta.subtotal}}{{bpjsData.swasta.subtotal}}{{else}}-{{/if}}</td>

        <!-- % AKTIF NON ASN NEGERI -->
        <td class="percent">{{#if participationRates.nonAsnNegeri.sma}}{{participationRates.nonAsnNegeri.sma}}%{{else}}-{{/if}}</td>
        <td class="percent">{{#if participationRates.nonAsnNegeri.smk}}{{participationRates.nonAsnNegeri.smk}}%{{else}}-{{/if}}</td>
        <td class="percent">{{#if participationRates.nonAsnNegeri.slb}}{{participationRates.nonAsnNegeri.slb}}%{{else}}-{{/if}}</td>
        <td class="percent">{{#if participationRates.nonAsnNegeri.subtotal}}{{participationRates.nonAsnNegeri.subtotal}}%{{else}}-{{/if}}</td>

        <!-- % AKTIF SWASTA -->
        <td class="percent">{{#if participationRates.swasta.sma}}{{participationRates.swasta.sma}}%{{else}}-{{/if}}</td>
        <td class="percent">{{#if participationRates.swasta.smk}}{{participationRates.swasta.smk}}%{{else}}-{{/if}}</td>
        <td class="percent">{{#if participationRates.swasta.slb}}{{participationRates.swasta.slb}}%{{else}}-{{/if}}</td>
        <td class="percent">{{#if participationRates.swasta.subtotal}}{{participationRates.swasta.subtotal}}%{{else}}-{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>

    <tfoot>
      <tr class="row-total">
        <td colspan="2">TOTAL / RATA-RATA</td>

        <!-- TOTAL DAPODIK NON ASN NEGERI -->
        <td>{{#if summary.totalDapodikNonAsnNegeri.sma}}{{summary.totalDapodikNonAsnNegeri.sma}}{{else}}-{{/if}}</td>
        <td>{{#if summary.totalDapodikNonAsnNegeri.smk}}{{summary.totalDapodikNonAsnNegeri.smk}}{{else}}-{{/if}}</td>
        <td>{{#if summary.totalDapodikNonAsnNegeri.slb}}{{summary.totalDapodikNonAsnNegeri.slb}}{{else}}-{{/if}}</td>
        <td>{{#if summary.totalDapodikNonAsnNegeri.subtotal}}{{summary.totalDapodikNonAsnNegeri.subtotal}}{{else}}-{{/if}}</td>

        <!-- TOTAL DAPODIK SWASTA -->
        <td>{{#if summary.totalDapodikSwasta.sma}}{{summary.totalDapodikSwasta.sma}}{{else}}-{{/if}}</td>
        <td>{{#if summary.totalDapodikSwasta.smk}}{{summary.totalDapodikSwasta.smk}}{{else}}-{{/if}}</td>
        <td>{{#if summary.totalDapodikSwasta.slb}}{{summary.totalDapodikSwasta.slb}}{{else}}-{{/if}}</td>
        <td>{{#if summary.totalDapodikSwasta.subtotal}}{{summary.totalDapodikSwasta.subtotal}}{{else}}-{{/if}}</td>

        <!-- TOTAL BPJS TERDAFTAR NON ASN NEGERI -->
        <td>{{#if summary.totalBpjs.nonAsnNegeri.sma}}{{summary.totalBpjs.nonAsnNegeri.sma}}{{else}}-{{/if}}</td>
        <td>{{#if summary.totalBpjs.nonAsnNegeri.smk}}{{summary.totalBpjs.nonAsnNegeri.smk}}{{else}}-{{/if}}</td>
        <td>{{#if summary.totalBpjs.nonAsnNegeri.slb}}{{summary.totalBpjs.nonAsnNegeri.slb}}{{else}}-{{/if}}</td>
        <td>{{#if summary.totalBpjs.nonAsnNegeri.subtotal}}{{summary.totalBpjs.nonAsnNegeri.subtotal}}{{else}}-{{/if}}</td>

        <!-- TOTAL BPJS TERDAFTAR SWASTA -->
        <td>{{#if summary.totalBpjs.swasta.sma}}{{summary.totalBpjs.swasta.sma}}{{else}}-{{/if}}</td>
        <td>{{#if summary.totalBpjs.swasta.smk}}{{summary.totalBpjs.swasta.smk}}{{else}}-{{/if}}</td>
        <td>{{#if summary.totalBpjs.swasta.slb}}{{summary.totalBpjs.swasta.slb}}{{else}}-{{/if}}</td>
        <td>{{#if summary.totalBpjs.swasta.subtotal}}{{summary.totalBpjs.swasta.subtotal}}{{else}}-{{/if}}</td>

        <!-- RATA2 % AKTIF NON ASN NEGERI -->
        <td class="percent">{{#if summary.averageParticipationRates.nonAsnNegeri.sma}}{{summary.averageParticipationRates.nonAsnNegeri.sma}}%{{else}}-{{/if}}</td>
        <td class="percent">{{#if summary.averageParticipationRates.nonAsnNegeri.smk}}{{summary.averageParticipationRates.nonAsnNegeri.smk}}%{{else}}-{{/if}}</td>
        <td class="percent">{{#if summary.averageParticipationRates.nonAsnNegeri.slb}}{{summary.averageParticipationRates.nonAsnNegeri.slb}}%{{else}}-{{/if}}</td>
        <td class="percent">{{#if summary.averageParticipationRates.nonAsnNegeri.subtotal}}{{summary.averageParticipationRates.nonAsnNegeri.subtotal}}%{{else}}-{{/if}}</td>

        <!-- RATA2 % AKTIF SWASTA -->
        <td class="percent">{{#if summary.averageParticipationRates.swasta.sma}}{{summary.averageParticipationRates.swasta.sma}}%{{else}}-{{/if}}</td>
        <td class="percent">{{#if summary.averageParticipationRates.swasta.smk}}{{summary.averageParticipationRates.swasta.smk}}%{{else}}-{{/if}}</td>
        <td class="percent">{{#if summary.averageParticipationRates.swasta.slb}}{{summary.averageParticipationRates.swasta.slb}}%{{else}}-{{/if}}</td>
        <td class="percent">{{#if summary.averageParticipationRates.swasta.subtotal}}{{summary.averageParticipationRates.swasta.subtotal}}%{{else}}-{{/if}}</td>
      </tr>
    </tfoot>
  </table>

  <div class="page-footer">
    <div class="code-left">REKAP 2025</div>
    <div class="code-right">KNODIK006</div>
  </div>

</body>
</html>
