<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <title>REKAP PTK PER PROVINSI</title>
  <style>
    {{asset 'template-pdf.css'}}
  </style>
</head>
<body>

  <!-- Header -->
  <div class="page-header">
    <div class="brand">
      <img src="{{asset "Log BPJS Ketenagakerjaan.png" "dataURI"}}" alt="BPJS Ketenagakerjaan" class="brand-logo" />
      <div class="brand-title">
        <div class="title-line-1">REKAP PTK PER JENJANG</div>
        <div class="title-line-2">PROVINSI ACEH, KAB ACEH BARAT
        </div>
        <div class="periode">Periode: 01-07-2025</div>
      </div>
    </div>
    <div class="meta">
      <div class="meta-row">Halaman : 1/1</div>
      <div class="meta-row">Tanggal Cetak : 09-09-2025</div>
      <div class="meta-row">Waktu Cetak : 15:45</div>
    </div>
  </div>

  <!-- Section -->
  <div class="section">
    <div class="label">NAMA KANTOR :</div>
    <div class="value">KANTOR PUSAT</div>
    <div class="underline"></div>
  </div>

  <!-- TABLE 1: JUMLAH GTK BERDASARKAN JENJANG (split NEGERI/SWASTA) -->
  <table class="table-kabkot">
    <thead>
      <tr>
        <th colspan="18">JUMLAH GTK BERDASARKAN JENJANG</th>
      </tr>
      <tr>
        <th colspan="9">NEGERI</th>
        <th colspan="9">SWASTA</th>
      </tr>
      <tr>
        <th>TK</th><th>PAUD</th><th>KB</th><th>SD</th><th>SMP</th><th>SMA</th><th>SMK</th><th>SLB</th><th>SUB TOTAL</th>
        <th>TK</th><th>PAUD</th><th>KB</th><th>SD</th><th>SMP</th><th>SMA</th><th>SMK</th><th>SLB</th><th>SUB TOTAL</th>
      </tr>
    </thead>
    <tbody>
      {{#each data}}
      <tr>
        <td>{{Jumlah.Non_ASN.Negeri.TK}}</td>
        <td>{{Jumlah.Non_ASN.Negeri.PAUD}}</td>
        <td>{{Jumlah.Non_ASN.Negeri.KB}}</td>
        <td>{{Jumlah.Non_ASN.Negeri.SD}}</td>
        <td>{{Jumlah.Non_ASN.Negeri.SMP}}</td>
        <td>{{Jumlah.Non_ASN.Negeri.SMA}}</td>
        <td>{{Jumlah.Non_ASN.Negeri.SMK}}</td>
        <td>{{Jumlah.Non_ASN.Negeri.SLB}}</td>
        <td>{{Jumlah.Subtotal_Non_ASN_Negeri}}</td>
        <td>{{Jumlah.Non_ASN.Swasta.TK}}</td>
        <td>{{Jumlah.Non_ASN.Swasta.PAUD}}</td>
        <td>{{Jumlah.Non_ASN.Swasta.KB}}</td>
        <td>{{Jumlah.Non_ASN.Swasta.SD}}</td>
        <td>{{Jumlah.Non_ASN.Swasta.SMP}}</td>
        <td>{{Jumlah.Non_ASN.Swasta.SMA}}</td>
        <td>{{Jumlah.Non_ASN.Swasta.SMK}}</td>
        <td>{{Jumlah.Non_ASN.Swasta.SLB}}</td>
        <td>{{Jumlah.Subtotal_Non_ASN_Swasta}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- TABLE 2: GTK TERDAFTAR BPJS KETENAGAKERJAAN (split NEGERI/SWASTA) -->
  <table class="table-kabkot" style="margin-top: 10px;">
    <thead>
      <tr>
        <th colspan="18">GTK TERDAFTAR BPJS KETENAGAKERJAAN</th>
      </tr>
      <tr>
        <th colspan="9">NEGERI</th>
        <th colspan="9">SWASTA</th>
      </tr>
      <tr>
        <th>TK</th><th>PAUD</th><th>KB</th><th>SD</th><th>SMP</th><th>SMA</th><th>SMK</th><th>SLB</th><th>SUB TOTAL</th>
        <th>TK</th><th>PAUD</th><th>KB</th><th>SD</th><th>SMP</th><th>SMA</th><th>SMK</th><th>SLB</th><th>SUB TOTAL</th>
      </tr>
    </thead>
    <tbody>
      {{#each data}}
      <tr>
        <td>{{BPJS.Non_ASN.Negeri.TK}}</td>
        <td>{{BPJS.Non_ASN.Negeri.PAUD}}</td>
        <td>{{BPJS.Non_ASN.Negeri.KB}}</td>
        <td>{{BPJS.Non_ASN.Negeri.SD}}</td>
        <td>{{BPJS.Non_ASN.Negeri.SMP}}</td>
        <td>{{BPJS.Non_ASN.Negeri.SMA}}</td>
        <td>{{BPJS.Non_ASN.Negeri.SMK}}</td>
        <td>{{BPJS.Non_ASN.Negeri.SLB}}</td>
        <td>{{BPJS.Subtotal_Non_ASN_Negeri}}</td>
        <td>{{BPJS.Non_ASN.Swasta.TK}}</td>
        <td>{{BPJS.Non_ASN.Swasta.PAUD}}</td>
        <td>{{BPJS.Non_ASN.Swasta.KB}}</td>
        <td>{{BPJS.Non_ASN.Swasta.SD}}</td>
        <td>{{BPJS.Non_ASN.Swasta.SMP}}</td>
        <td>{{BPJS.Non_ASN.Swasta.SMA}}</td>
        <td>{{BPJS.Non_ASN.Swasta.SMK}}</td>
        <td>{{BPJS.Non_ASN.Swasta.SLB}}</td>
        <td>{{BPJS.Subtotal_Non_ASN_Swasta}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- TABLE 3: %KEPESERTAAN AKTIF (split NEGERI/SWASTA) -->
  <table class="table-kabkot" style="margin-top: 10px;">
    <thead>
      <tr>
        <th colspan="18">%KEPESERTAAN AKTIF</th>
      </tr>
      <tr>
        <th colspan="9">NEGERI</th>
        <th colspan="9">SWASTA</th>
      </tr>
      <tr>
        <th>TK</th><th>PAUD</th><th>KB</th><th>SD</th><th>SMP</th><th>SMA</th><th>SMK</th><th>SLB</th><th>SUB TOTAL</th>
        <th>TK</th><th>PAUD</th><th>KB</th><th>SD</th><th>SMP</th><th>SMA</th><th>SMK</th><th>SLB</th><th>SUB TOTAL</th>
      </tr>
    </thead>
    <tbody>
      {{#each data}}
      <tr>
        <td>{{Kepesertaan_Aktif.Non_ASN.Negeri.TK}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Negeri.PAUD}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Negeri.KB}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Negeri.SD}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Negeri.SMP}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Negeri.SMA}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Negeri.SMK}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Negeri.SLB}}</td>
        <td>{{Kepesertaan_Aktif.Subtotal_Non_ASN_Negeri}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Swasta.TK}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Swasta.PAUD}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Swasta.KB}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Swasta.SD}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Swasta.SMP}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Swasta.SMA}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Swasta.SMK}}</td>
        <td>{{Kepesertaan_Aktif.Non_ASN.Swasta.SLB}}</td>
        <td>{{Kepesertaan_Aktif.Subtotal_Non_ASN_Swasta}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Footer -->
  <div class="page-footer">
    <div class="code-left">REKAP 2025</div>
    <div class="code-right">KNODIK003</div>
  </div>

</body>
</html>
