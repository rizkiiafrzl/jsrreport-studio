<style>
  table { width:100%; border-collapse:collapse; table-layout:fixed; font-family: Arial, Helvetica, sans-serif; }
  table, th, td { font-size:9pt !important; }
  th, td { padding:3px 6px; border:1px solid #cfcfcf; text-align:center; vertical-align:middle; }
  thead th { background:#f5f5f5; font-weight:700; }
  .title { background:#fff; font-size:9pt !important; text-align:left; }
  .col-no { width:40px; }
  .col-prov { width:200px; text-align:left; }
  .n { width:50px; }
  .w { width:70px; }
  .subtotal { background:#f0f0f0; font-weight:bold; }
</style>

<table border="1">
  <colgroup>
    <col class="col-no" />
    <col class="col-prov" />

    <!-- JUMLAH GTK BERDASARKAN JENJANG - NEGERI -->
    <col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="w" />
    <!-- JUMLAH GTK BERDASARKAN JENJANG - SWASTA -->
    <col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="w" />
    <!-- GTK TERDAFTAR BPJS - NEGERI -->
    <col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="w" />
    <!-- GTK TERDAFTAR BPJS - SWASTA -->
    <col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="w" />
    <!-- % KEPESERTAAN AKTIF - NEGERI -->
    <col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="w" />
    <!-- % KEPESERTAAN AKTIF - SWASTA -->
    <col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="n" /><col class="w" />
  </colgroup>

  <thead>
    <tr>
      <th colspan="56" class="title" style="text-align: right;">
        {{@root.code}}
      </th>
    </tr>
        <tr>
      <th colspan="56" class="title" style= "text-align: center;">
        {{@root.title}} ({{@root.subtitle}})
      </th>
    </tr>
        <tr>
     <th colspan="56" class="title" style="text-align: right;">
        Periode: {{@root.period}}
      </th>
    </tr>
    <tr>
      <th rowspan="3">No</th>
      <th rowspan="3">Nama Provinsi</th>
      <th colspan="18">JUMLAH GTK BERDASARKAN JENJANG</th>
      <th colspan="18">GTK TERDAFTAR BPJS KETENAGAKERJAAN</th>
      <th colspan="18">% KEPESERTAAN AKTIF</th>
    </tr>
    <tr>
      <th colspan="9">NEGERI</th>
      <th colspan="9">SWASTA</th>
      <th colspan="9">NEGERI</th>
      <th colspan="9">SWASTA</th>
      <th colspan="9">NEGERI</th>
      <th colspan="9">SWASTA</th>
    </tr>
    <tr>
      <th>TK</th><th>PAUD</th><th>KB</th><th>SD</th><th>SMP</th><th>SMA</th><th>SMK</th><th>SLB</th><th class="subtotal">Subtotal</th>
      <th>TK</th><th>PAUD</th><th>KB</th><th>SD</th><th>SMP</th><th>SMA</th><th>SMK</th><th>SLB</th><th class="subtotal">Subtotal</th>
      <th>TK</th><th>PAUD</th><th>KB</th><th>SD</th><th>SMP</th><th>SMA</th><th>SMK</th><th>SLB</th><th class="subtotal">Subtotal</th>
      <th>TK</th><th>PAUD</th><th>KB</th><th>SD</th><th>SMP</th><th>SMA</th><th>SMK</th><th>SLB</th><th class="subtotal">Subtotal</th>
      <th>TK</th><th>PAUD</th><th>KB</th><th>SD</th><th>SMP</th><th>SMA</th><th>SMK</th><th>SLB</th><th class="subtotal">Subtotal</th>
      <th>TK</th><th>PAUD</th><th>KB</th><th>SD</th><th>SMP</th><th>SMA</th><th>SMK</th><th>SLB</th><th class="subtotal">Subtotal</th>
    </tr>
  </thead>

  <tbody>
    {{#each data}}
    <tr>
      <td data-type="number" data-format="0">{{No}}</td>
      <td style="text-align:left">{{Provinsi}}</td>

      <!-- JUMLAH GTK BERDASARKAN JENJANG - NEGERI -->
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Negeri.TK}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Negeri.PAUD}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Negeri.KB}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Negeri.SD}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Negeri.SMP}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Negeri.SMA}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Negeri.SMK}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Negeri.SLB}}</td>
      <td class="subtotal" data-type="number" data-format="#,##0">{{Jumlah.Subtotal_Non_ASN_Negeri}}</td>

      <!-- JUMLAH GTK BERDASARKAN JENJANG - SWASTA -->
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Swasta.TK}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Swasta.PAUD}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Swasta.KB}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Swasta.SD}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Swasta.SMP}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Swasta.SMA}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Swasta.SMK}}</td>
      <td data-type="number" data-format="#,##0">{{Jumlah.Non_ASN.Swasta.SLB}}</td>
      <td class="subtotal" data-type="number" data-format="#,##0">{{Jumlah.Subtotal_Non_ASN_Swasta}}</td>

      <!-- GTK TERDAFTAR BPJS KETENAGAKERJAAN - NEGERI -->
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Negeri.TK}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Negeri.PAUD}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Negeri.KB}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Negeri.SD}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Negeri.SMP}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Negeri.SMA}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Negeri.SMK}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Negeri.SLB}}</td>
      <td class="subtotal" data-type="number" data-format="#,##0">{{BPJS.Subtotal_Non_ASN_Negeri}}</td>

      <!-- GTK TERDAFTAR BPJS KETENAGAKERJAAN - SWASTA -->
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Swasta.TK}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Swasta.PAUD}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Swasta.KB}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Swasta.SD}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Swasta.SMP}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Swasta.SMA}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Swasta.SMK}}</td>
      <td data-type="number" data-format="#,##0">{{BPJS.Non_ASN.Swasta.SLB}}</td>
      <td class="subtotal" data-type="number" data-format="#,##0">{{BPJS.Subtotal_Non_ASN_Swasta}}</td>

      <!-- % KEPESERTAAN AKTIF - NEGERI -->
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Negeri.TK}}{{Kepesertaan_Aktif.Non_ASN.Negeri.TK}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Negeri.PAUD}}{{Kepesertaan_Aktif.Non_ASN.Negeri.PAUD}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Negeri.KB}}{{Kepesertaan_Aktif.Non_ASN.Negeri.KB}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Negeri.SD}}{{Kepesertaan_Aktif.Non_ASN.Negeri.SD}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Negeri.SMP}}{{Kepesertaan_Aktif.Non_ASN.Negeri.SMP}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Negeri.SMA}}{{Kepesertaan_Aktif.Non_ASN.Negeri.SMA}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Negeri.SMK}}{{Kepesertaan_Aktif.Non_ASN.Negeri.SMK}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Negeri.SLB}}{{Kepesertaan_Aktif.Non_ASN.Negeri.SLB}}%{{else}}0{{/if}}</td>
      <td class="subtotal">{{#if Kepesertaan_Aktif.Subtotal_Non_ASN_Negeri}}{{Kepesertaan_Aktif.Subtotal_Non_ASN_Negeri}}%{{else}}0{{/if}}</td>

      <!-- % KEPESERTAAN AKTIF - SWASTA -->
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Swasta.TK}}{{Kepesertaan_Aktif.Non_ASN.Swasta.TK}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Swasta.PAUD}}{{Kepesertaan_Aktif.Non_ASN.Swasta.PAUD}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Swasta.KB}}{{Kepesertaan_Aktif.Non_ASN.Swasta.KB}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Swasta.SD}}{{Kepesertaan_Aktif.Non_ASN.Swasta.SD}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Swasta.SMP}}{{Kepesertaan_Aktif.Non_ASN.Swasta.SMP}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Swasta.SMA}}{{Kepesertaan_Aktif.Non_ASN.Swasta.SMA}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Swasta.SMK}}{{Kepesertaan_Aktif.Non_ASN.Swasta.SMK}}%{{else}}0{{/if}}</td>
      <td>{{#if Kepesertaan_Aktif.Non_ASN.Swasta.SLB}}{{Kepesertaan_Aktif.Non_ASN.Swasta.SLB}}%{{else}}0{{/if}}</td>
      <td class="subtotal">{{#if Kepesertaan_Aktif.Subtotal_Non_ASN_Swasta}}{{Kepesertaan_Aktif.Subtotal_Non_ASN_Swasta}}%{{else}}0{{/if}}</td>
    </tr>
    {{/each}}
  </tbody>

  <tfoot>
    <tr style="font-weight:700; background:#dcdcdc;">
      <td colspan="2">TOTAL</td>

      <!-- TOTAL JUMLAH GTK BERDASARKAN JENJANG - NEGERI -->
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Negeri.TK}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Negeri.PAUD}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Negeri.KB}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Negeri.SD}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Negeri.SMP}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Negeri.SMA}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Negeri.SMK}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Negeri.SLB}}</td>
      <td class="subtotal" data-type="number" data-format="#,##0">{{totals.Jumlah.Subtotal_Non_ASN_Negeri}}</td>

      <!-- TOTAL JUMLAH GTK BERDASARKAN JENJANG - SWASTA -->
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Swasta.TK}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Swasta.PAUD}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Swasta.KB}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Swasta.SD}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Swasta.SMP}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Swasta.SMA}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Swasta.SMK}}</td>
      <td data-type="number" data-format="#,##0">{{totals.Jumlah.Non_ASN.Swasta.SLB}}</td>
      <td class="subtotal" data-type="number" data-format="#,##0">{{totals.Jumlah.Subtotal_Non_ASN_Swasta}}</td>

      <!-- TOTAL GTK TERDAFTAR BPJS KETENAGAKERJAAN - NEGERI -->
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Negeri.TK}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Negeri.PAUD}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Negeri.KB}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Negeri.SD}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Negeri.SMP}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Negeri.SMA}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Negeri.SMK}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Negeri.SLB}}</td>
      <td class="subtotal" data-type="number" data-format="#,##0">{{totals.BPJS.Subtotal_Non_ASN_Negeri}}</td>

      <!-- TOTAL GTK TERDAFTAR BPJS KETENAGAKERJAAN - SWASTA -->
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Swasta.TK}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Swasta.PAUD}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Swasta.KB}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Swasta.SD}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Swasta.SMP}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Swasta.SMA}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Swasta.SMK}}</td>
      <td data-type="number" data-format="#,##0">{{totals.BPJS.Non_ASN.Swasta.SLB}}</td>
      <td class="subtotal" data-type="number" data-format="#,##0">{{totals.BPJS.Subtotal_Non_ASN_Swasta}}</td>

      <!-- TOTAL % KEPESERTAAN AKTIF - NEGERI -->
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Negeri.TK}}{{totals.Kepesertaan_Aktif.Non_ASN.Negeri.TK}}%{{else}}0{{/if}}</td>
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Negeri.PAUD}}{{totals.Kepesertaan_Aktif.Non_ASN.Negeri.PAUD}}%{{else}}0{{/if}}</td>
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Negeri.KB}}{{totals.Kepesertaan_Aktif.Non_ASN.Negeri.KB}}%{{else}}0{{/if}}</td>
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Negeri.SD}}{{totals.Kepesertaan_Aktif.Non_ASN.Negeri.SD}}%{{else}}0{{/if}}</td>
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Negeri.SMP}}{{totals.Kepesertaan_Aktif.Non_ASN.Negeri.SMP}}%{{else}}0{{/if}}</td>
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Negeri.SMA}}{{totals.Kepesertaan_Aktif.Non_ASN.Negeri.SMA}}%{{else}}0{{/if}}</td>
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Negeri.SMK}}{{totals.Kepesertaan_Aktif.Non_ASN.Negeri.SMK}}%{{else}}0{{/if}}</td>
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Negeri.SLB}}{{totals.Kepesertaan_Aktif.Non_ASN.Negeri.SLB}}%{{else}}0{{/if}}</td>
      <td class="subtotal">{{#if totals.Kepesertaan_Aktif.Subtotal_Non_ASN_Negeri}}{{totals.Kepesertaan_Aktif.Subtotal_Non_ASN_Negeri}}%{{else}}0{{/if}}</td>

      <!-- TOTAL % KEPESERTAAN AKTIF - SWASTA -->
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Swasta.TK}}{{totals.Kepesertaan_Aktif.Non_ASN.Swasta.TK}}%{{else}}0{{/if}}</td>
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Swasta.PAUD}}{{totals.Kepesertaan_Aktif.Non_ASN.Swasta.PAUD}}%{{else}}0{{/if}}</td>
