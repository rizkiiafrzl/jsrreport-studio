      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Swasta.SD}}{{totals.Kepesertaan_Aktif.Non_ASN.Swasta.SD}}%{{else}}0{{/if}}</td>
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Swasta.SMP}}{{totals.Kepesertaan_Aktif.Non_ASN.Swasta.SMP}}%{{else}}0{{/if}}</td>
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Swasta.SMA}}{{totals.Kepesertaan_Aktif.Non_ASN.Swasta.SMA}}%{{else}}0{{/if}}</td>
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Swasta.SMK}}{{totals.Kepesertaan_Aktif.Non_ASN.Swasta.SMK}}%{{else}}0{{/if}}</td>
      <td>{{#if totals.Kepesertaan_Aktif.Non_ASN.Swasta.SLB}}{{totals.Kepesertaan_Aktif.Non_ASN.Swasta.SLB}}%{{else}}0{{/if}}</td>
      <td class="subtotal">{{#if totals.Kepesertaan_Aktif.Subtotal_Non_ASN_Swasta}}{{totals.Kepesertaan_Aktif.Subtotal_Non_ASN_Swasta}}%{{else}}0{{/if}}</td>
