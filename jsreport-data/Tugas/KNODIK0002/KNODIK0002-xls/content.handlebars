<style>
  table { width:100%; border-collapse:collapse; table-layout:fixed; font-family: Arial, Helvetica, sans-serif; }
  th, td { padding:3px 6px; border:1px solid #cfcfcf; text-align:center; font-size:10px; vertical-align:middle; }
  thead th { background:#f5f5f5; font-weight:700; }
  .title { background:#fff; font-size:12px; text-align:left; }
  .col-no { width:40px; }
  .col-prov { width:200px; text-align:left; }
  .n { width:50px; }
  .w { width:70px; }
  .subtotal { background:#f0f0f0; font-weight:bold; }
</style>

<table>
  <colgroup>
    <col class="col-no" style="width: 40px;" />
    <col class="col-prov" style="width: 100px;" />
    <col class="col-kab" style="width: 140px;" />
    <col class="col-sekolah" style="width: 250px;" />
    <col class="col-jumlah-gtk" style="width: 20px; min-width: 20px; max-width: 20px;" />
    <col class="col-bpjs" style="width: 60px; min-width: 60px; max-width: 60px;" />
    <col class="col-belum-terdaftar" style="width: 60px; min-width: 60px; max-width: 60px;" />
    <col class="col-persen" style="width: 60px; min-width: 60px; max-width: 60px;" />
    <col class="col-alamat" style="width: 360px; min-width: 360px; max-width: 360px;" />
    <col class="col-email" style="width: 250px; min-width: 250px; max-width: 250px;" />
    <col class="col-hp" style="width: 120px; min-width: 120px; max-width: 120px;" />
  </colgroup>
  <thead>
    <tr>
      <th colspan="11" class="title" style="text-align: right;">
        {{@root.code}}
      </th>
    </tr>
        <tr>
      <th colspan="11" class="title" style= "text-align: center;">
        {{@root.title}} ({{@root.subtitle}})
      </th>
    </tr>
        <tr>
     <th colspan="11" class="title" style="text-align: right;">
        Periode: {{@root.period}}
      </th>
    </tr>
    <tr>
      <th rowspan="2">No</th>
      <th rowspan="2">NAMA PROVINSI</th>
      <th rowspan="2">NAMA KAB KOTA</th>
      <th rowspan="2">NAMA SATUAN PENDIDIKAN</th>
      <th colspan="7">PTK DAPODIK</th>
    </tr>
    <tr>
      <th>JUMLAH GTK</th>
      <th>TERDAFTAR BPJS KETENAGAKERJAAN</th>
      <th>PTK BELUM TERDAFTAR</th>
      <th>% TERDAFTAR</th>
      <th>Alamat</th>
      <th>Email</th>
      <th>No HP</th>
    </tr>
  </thead>
  <tbody>
    {{#each data}}
    <tr>
      <td>{{No}}</td>
      <td>{{Provinsi}}</td>
      <td>{{Kabupaten_Kota}}</td>
      <td>{{Nama_Satuan_Pendidikan}}</td>
      <td class="col-jumlah-gtk">{{PTK_Dapodik}}</td>
      <td class="col-bpjs">{{Terdaftar_BPJS}}</td>
      <td class="col-belum-terdaftar">{{Belum_Terdaftar}}</td>
      <td class="col-persen">{{Persen_Terdaftar}}</td>
      <td class="col-alamat">{{Alamat}}</td>
      <td class="col-email">{{Email}}</td>
      <td class="col-hp">{{No_HP}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

{{{xlsxPrint}}}
